# Copy to .env (optional - every variable has a default)
PORT=3000
# SQLite file location. Created on first start and seeded from seed/seed.json.
DB_PATH=./data/studio.db
# Timezone used to decide what "today" is for the date rules (7-90 days, 14 days, 3-day cancel).
STUDIO_TZ=Asia/Kolkata
# Session lifetime in hours
SESSION_HOURS=24
